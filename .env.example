# Cloud Cost Guardian configuration (copy to .env and adjust; NEVER commit .env)
# Every value is optional — sensible defaults are built in.

# --- Mode & region ---------------------------------------------------------
CCG_MODE=demo                      # demo | local | aws
CCG_AWS_REGION=us-east-1
# CCG_AWS_PROFILE=my-readonly-profile   # standard AWS profile for optional aws mode
# CCG_AWS_ENDPOINT_URL=http://localhost:4566   # LocalStack / moto server for 'local' mode

# --- Detection thresholds --------------------------------------------------
CCG_EBS_MIN_AGE_DAYS=7
CCG_EC2_CPU_THRESHOLD_PERCENT=5.0
CCG_EC2_OBSERVATION_HOURS=48
CCG_EC2_MIN_SAMPLES=12
CCG_RDS_CPU_THRESHOLD_PERCENT=10.0
CCG_RDS_OBSERVATION_HOURS=168
CCG_SNAPSHOT_MAX_AGE_DAYS=90

# --- Protection --------------------------------------------------------------
# Comma-separated key=value pairs. Any matching tag makes a resource untouchable.
CCG_PROTECTED_TAGS=cost-guardian-protected=true,Environment=production

# --- Notifications -----------------------------------------------------------
CCG_NOTIFICATION_PROVIDER=mock      # mock | slack | sns
# CCG_SLACK_WEBHOOK_URL=             # set only via env/secret store, never commit
# CCG_SNS_TOPIC_ARN=

# --- Paths -------------------------------------------------------------------
CCG_ARTIFACTS_DIR=artifacts
CCG_DATA_DIR=data
# CCG_PRICING_CATALOG_PATH=./my-pricing.json
# CCG_FIXTURE_INVENTORY_PATH=./demo/sample_aws_inventory.json
# CCG_FIXTURE_METRICS_PATH=./demo/sample_cloudwatch_metrics.json

# --- Logging -----------------------------------------------------------------
CCG_LOG_LEVEL=INFO
CCG_LOG_FORMAT=text                 # text | json
